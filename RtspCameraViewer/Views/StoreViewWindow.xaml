<Window x:Class="RtspCameraViewer.Views.StoreViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Watch by Store" Height="800" Width="1200" MinHeight="480" MinWidth="640"
        Background="{StaticResource AppBackground}" FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">
    <DockPanel LastChildFill="True">

        <Border DockPanel.Dock="Top" Background="#25252E" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Watch by Store" Foreground="{StaticResource TextPrimary}"
                           FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="SelectedStoreText" Grid.Column="1" Text="" Foreground="{StaticResource TextSecondary}"
                           FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Store list -->
            <Border Grid.Column="0" Background="#1B1B21">
                <StackPanel>
                    <TextBlock Text="STORES" Foreground="{StaticResource TextSecondary}" FontSize="10.5"
                               FontWeight="SemiBold" Margin="14,14,0,6"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="StoreListPanel" Margin="8,0,8,8"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Live grid for the selected store -->
            <Grid Grid.Column="1">
                <TextBlock x:Name="EmptyStateText" Text="Pick a store on the left to watch its cameras."
                           Foreground="{StaticResource TextSecondary}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <UniformGrid x:Name="GridHost" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
