<Window x:Class="RtspCameraViewer.Views.ImportCamerasDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Upload Cameras" Height="580" Width="640"
        WindowStartupLocation="CenterOwner" MinHeight="480" MinWidth="540"
        Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="File" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FilePathBox" Style="{StaticResource InputBox}" IsReadOnly="True" Margin="0,0,8,0"/>
            <Button Grid.Column="1" Content="Browse…" Width="90" Height="32" Click="Browse_Click" Style="{StaticResource ToolButton}"/>
        </Grid>
        <TextBlock Grid.Row="2" Text="Any .env, text, config, CSV or Excel file — every rtsp:// address in it is picked up. You can also drop a file onto this window."
                   Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>

        <TextBlock Grid.Row="3" Text="Add these cameras to class" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="4" x:Name="ClassCombo" IsEditable="True" Margin="0,0,0,4"
                  ToolTip="Pick an existing class, or type a new name to create one"/>
        <TextBlock Grid.Row="5" Text="Pick an existing class, or type a new name to start one. Leave blank to import them unassigned."
                   Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <Border Grid.Row="6" Background="{StaticResource TileBackground}" CornerRadius="4" Margin="0,0,0,10">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="10,8,10,6">
                    <TextBlock x:Name="SummaryText" Text="Choose a file to see what it contains."
                               Foreground="{StaticResource TextSecondary}" FontSize="11.5" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Select all" Click="SelectAll_Click" Height="24" Padding="8,0"
                                FontSize="11" Style="{StaticResource ToolButton}" Margin="0,0,6,0"/>
                        <Button Content="Select none" Click="SelectNone_Click" Height="24" Padding="8,0"
                                FontSize="11" Style="{StaticResource ToolButton}"/>
                    </StackPanel>
                </Grid>

                <!-- Names are editable in place: the file supplies a guess, and correcting it
                     here is far less work than fixing eight tiles after the fact. -->
                <ListBox x:Name="PreviewList" Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource TextPrimary}" HorizontalContentAlignment="Stretch"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="4">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Include, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputBox}" FontSize="11.5" Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Url}" Foreground="{StaticResource TextSecondary}"
                                               FontFamily="Consolas" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Url}"/>
                                    <TextBlock Text="{Binding Note}" Foreground="{StaticResource WarnBrush}" FontSize="10"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="7" x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" FontSize="12"
                   TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Height="32" Margin="0,0,8,0" Click="Cancel_Click" Style="{StaticResource ToolButton}"/>
            <Button x:Name="ImportButton" Content="Add cameras" Width="130" Height="32" Click="Import_Click"
                    Style="{StaticResource ToolButton}" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
