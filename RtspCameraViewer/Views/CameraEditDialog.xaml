<Window x:Class="RtspCameraViewer.Views.CameraEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Camera" Height="560" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Bulk entry, offered before the single-camera form: someone with a DVR's .env or
             an installer's camera list should not have to retype eight URLs by hand. -->
        <Border x:Name="UploadPanel" Background="{StaticResource TileBackground}" CornerRadius="6" Padding="12,10" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Have a file of cameras?" Foreground="{StaticResource TextPrimary}" FontSize="12.5" FontWeight="SemiBold"/>
                    <TextBlock Text=".env, text, CSV or Excel — RTSP URLs are found automatically"
                               Foreground="{StaticResource TextSecondary}" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="UploadButton" Content="Upload…" Width="90" Height="30"
                        VerticalAlignment="Center" Margin="10,0,0,0" Click="Upload_Click" Style="{StaticResource ToolButton}"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Text="Camera name" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
        <TextBox Grid.Row="2" x:Name="NameBox" Style="{StaticResource InputBox}" Margin="0,0,0,14"/>

        <TextBlock Grid.Row="3" Text="RTSP URL  (rtsp://host:port/path)" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
        <TextBox Grid.Row="4" x:Name="UrlBox" Style="{StaticResource InputBox}" Margin="0,0,0,14"/>

        <TextBlock Grid.Row="5" Text="Camera class  (groups cameras in the class filter)"
                   Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="6" x:Name="ClassCombo" IsEditable="True" Margin="0,0,0,4"
                  ToolTip="Pick an existing class, or type a new name to create one"/>
        <TextBlock Grid.Row="7" Text="Pick an existing class to add this camera to it, or type a new name to start one. Leave blank for no class."
                   Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>

        <Grid Grid.Row="8" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Username (optional)" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                <TextBox x:Name="UserBox" Style="{StaticResource InputBox}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Password (optional)" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PassBox" Background="#33333D" Foreground="{StaticResource TextPrimary}"
                             Padding="8,6" BorderBrush="#44444F" BorderThickness="1" CaretBrush="White"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="9" Text="Leave username/password blank if your URL already contains them, e.g. rtsp://user:pass@host/..."
                   Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="10" x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" FontSize="12"
                   TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="12" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Height="32" Margin="0,0,8,0" Click="Cancel_Click" Style="{StaticResource ToolButton}"/>
            <Button x:Name="SaveButton" Content="Save" Width="90" Height="32" Click="Save_Click" Style="{StaticResource ToolButton}"/>
        </StackPanel>
    </Grid>
</Window>
