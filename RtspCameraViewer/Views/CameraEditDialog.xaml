<Window x:Class="RtspCameraViewer.Views.CameraEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Camera" Height="380" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Camera name" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
        <TextBox Grid.Row="1" x:Name="NameBox" Style="{StaticResource InputBox}" Margin="0,0,0,14"/>

        <TextBlock Grid.Row="2" Text="RTSP URL  (rtsp://host:port/path)" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
        <TextBox Grid.Row="3" x:Name="UrlBox" Style="{StaticResource InputBox}" Margin="0,0,0,14"/>

        <Grid Grid.Row="4" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Username (optional)" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                <TextBox x:Name="UserBox" Style="{StaticResource InputBox}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Password (optional)" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PassBox" Background="#33333D" Foreground="{StaticResource TextPrimary}"
                             Padding="8,6" BorderBrush="#44444F" BorderThickness="1" CaretBrush="White"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="5" Text="Leave username/password blank if your URL already contains them, e.g. rtsp://user:pass@host/..."
                   Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="6" x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" FontSize="12"
                   TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Height="32" Margin="0,0,8,0" Click="Cancel_Click" Style="{StaticResource ToolButton}"/>
            <Button x:Name="SaveButton" Content="Save" Width="90" Height="32" Click="Save_Click" Style="{StaticResource ToolButton}"/>
        </StackPanel>
    </Grid>
</Window>
