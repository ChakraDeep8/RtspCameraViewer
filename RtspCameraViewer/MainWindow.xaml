<Window x:Class="RtspCameraViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RTSP Camera Viewer" Height="800" Width="1200" MinHeight="480" MinWidth="640"
        Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        KeyDown="MainWindow_KeyDown">
    <DockPanel LastChildFill="True">

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="#25252E" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="RTSP Camera Viewer" Foreground="{StaticResource TextPrimary}"
                           FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="CameraCountText" Grid.Column="1" Text="0 cameras"
                           Foreground="{StaticResource TextSecondary}" FontSize="12"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="+ Add Camera" Height="32" Padding="14,0" Click="AddCamera_Click"
                            Style="{StaticResource ToolButton}"/>
                    <Button x:Name="SettingsButton" Content="&#xE713;" FontFamily="Segoe MDL2 Assets"
                            Width="34" Height="32" Margin="6,0,0,0" FontSize="14"
                            Click="Settings_Click" ToolTip="Settings — stream quality and camera classes"
                            Style="{StaticResource IconButton}"/>
                    <Border Width="1" Background="#3A3A44" Margin="10,4" />
                    <Button x:Name="AppFullscreenButton" Content="&#xE740;" FontFamily="Segoe MDL2 Assets"
                            Width="34" Height="32" Margin="0,0,4,0" FontSize="14"
                            Click="AppFullscreen_Click" ToolTip="Full screen (F11)" Style="{StaticResource IconButton}"/>
                    <Button x:Name="MinimizeButton" Content="&#xE921;" FontFamily="Segoe MDL2 Assets"
                            Width="34" Height="32" Margin="0,0,4,0" FontSize="12"
                            Click="Minimize_Click" ToolTip="Minimize" Style="{StaticResource IconButton}"/>
                    <Button x:Name="RestoreButton" Content="&#xE922;" FontFamily="Segoe MDL2 Assets"
                            Width="34" Height="32" Margin="0,0,4,0" FontSize="12"
                            Click="MaximizeRestore_Click" ToolTip="Maximize" Style="{StaticResource IconButton}"/>
                    <Button x:Name="CloseButton" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                            Width="34" Height="32" FontSize="12" Click="CloseWindow_Click"
                            ToolTip="Close" Style="{StaticResource IconButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Class filter bar: shown once at least one camera has been given a class. Picking a
             class filters the grid below to just that group; "All Classes" shows everything. -->
        <Border x:Name="StoreBar" DockPanel.Dock="Top" Background="#1B1B21" Padding="14,8" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="CAMERA CLASS" Foreground="{StaticResource TextSecondary}" FontSize="10.5"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="StoreSelector" Width="240" SelectionChanged="StoreSelector_SelectionChanged"/>
            </StackPanel>
        </Border>

        <!-- Expanded-view bar. Shown only while one camera is expanded; the collapse control
             lives here rather than over the video, because a native video surface paints over
             anything WPF draws on top of it. -->
        <Border x:Name="ExpandBar" DockPanel.Dock="Top" Background="#1B1B21" Padding="14,6" Visibility="Collapsed">
            <Grid>
                <TextBlock x:Name="ExpandNameText" Text="Expanded" Foreground="{StaticResource TextSecondary}"
                           FontSize="11.5" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Right"
                        Width="30" Height="26" FontSize="12" Click="ExitFullscreen_Click"
                        ToolTip="Back to the grid (Esc)" Style="{StaticResource IconButton}"/>
            </Grid>
        </Border>

        <!-- Main content: grid of live tiles, or empty-state hint -->
        <Grid>
            <TextBlock x:Name="EmptyStateText" Text="No cameras yet. Click &quot;+ Add Camera&quot; to add your first RTSP stream."
                       Foreground="{StaticResource TextSecondary}" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

            <UniformGrid x:Name="GridHost" SizeChanged="GridHost_SizeChanged"/>

        </Grid>
    </DockPanel>
</Window>
