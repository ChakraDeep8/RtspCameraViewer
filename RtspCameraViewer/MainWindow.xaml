<Window x:Class="RtspCameraViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RTSP Camera Viewer" Height="800" Width="1200" MinHeight="480" MinWidth="640"
        Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        KeyDown="MainWindow_KeyDown">
    <DockPanel LastChildFill="True">

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="#25252E" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="RTSP Camera Viewer" Foreground="{StaticResource TextPrimary}"
                           FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="CameraCountText" Grid.Column="1" Text="0 cameras"
                           Foreground="{StaticResource TextSecondary}" FontSize="12"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="+ Add Camera" Height="32" Padding="14,0" Click="AddCamera_Click"
                            Style="{StaticResource ToolButton}"/>
                    <Border Width="1" Background="#3A3A44" Margin="10,4" />
                    <Button x:Name="AppFullscreenButton" Content="&#xE740;" FontFamily="Segoe MDL2 Assets"
                            Width="34" Height="32" Margin="0,0,4,0" FontSize="14"
                            Click="AppFullscreen_Click" ToolTip="Full screen (F11)" Style="{StaticResource ToolButton}"/>
                    <Button x:Name="MinimizeButton" Content="&#xE921;" FontFamily="Segoe MDL2 Assets"
                            Width="34" Height="32" Margin="0,0,4,0" FontSize="12"
                            Click="Minimize_Click" ToolTip="Minimize" Style="{StaticResource ToolButton}"/>
                    <Button x:Name="RestoreButton" Content="&#xE922;" FontFamily="Segoe MDL2 Assets"
                            Width="34" Height="32" Margin="0,0,4,0" FontSize="12"
                            Click="MaximizeRestore_Click" ToolTip="Maximize" Style="{StaticResource ToolButton}"/>
                    <Button x:Name="CloseButton" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                            Width="34" Height="32" FontSize="12" Click="CloseWindow_Click"
                            ToolTip="Close" Style="{StaticResource ToolButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content: grid of live tiles, or empty-state hint -->
        <Grid>
            <TextBlock x:Name="EmptyStateText" Text="No cameras yet. Click &quot;+ Add Camera&quot; to add your first RTSP stream."
                       Foreground="{StaticResource TextSecondary}" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

            <UniformGrid x:Name="GridHost" />

            <!-- Fullscreen overlay -->
            <Grid x:Name="FullscreenHost" Background="Black" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ContentControl x:Name="FullscreenContent"/>
                <Button Content="✕ Exit full screen (Esc)" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,14,14,0" Height="32" Padding="12,0" Click="ExitFullscreen_Click"
                        Style="{StaticResource ToolButton}" Panel.ZIndex="10"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
