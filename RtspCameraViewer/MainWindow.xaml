<Window x:Class="RtspCameraViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="RTSP Camera Viewer" Height="800" Width="1200" MinHeight="480" MinWidth="640"
        Background="{StaticResource AppBackground}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Icon="Assets/AppIcon.ico"
        WindowStartupLocation="CenterScreen"
        KeyDown="MainWindow_KeyDown">

    <!--
        The title bar is ours, merged with the toolbar, the way Windows 11 apps (Settings,
        Terminal) do it. WindowChrome keeps native dragging, double-click-to-maximize, Aero Snap
        and resize borders. Note this deliberately avoids AllowsTransparency: that switches WPF
        to layered-window rendering, which cannot host the native video windows at all.
        The minimize / maximize / close buttons are the SYSTEM's, not ours. DWM paints them into
        the extended frame regardless, so drawing our own as well showed every glyph doubled;
        UseAeroCaptionButtons=True makes the real ones clickable instead. They are proper Windows
        11 buttons - dark, red close, and the Snap Layouts flyout on maximize.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="-1"
                            CornerRadius="0" UseAeroCaptionButtons="True"/>
    </shell:WindowChrome.WindowChrome>

    <!-- A maximized custom-chrome window overhangs the screen by its frame; RootBorder's margin
         takes that back (see UpdateMaximizedInset) or the title bar is clipped off the top. -->
    <Border x:Name="RootBorder">
        <DockPanel LastChildFill="True">

            <!-- Title bar -->
            <Grid DockPanel.Dock="Top" Height="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <!-- The app's own icon, not a Segoe glyph, so the title bar matches the
                         taskbar button, Alt+Tab and the shortcut. -->
                    <Image Source="Assets/AppIcon.ico" Width="18" Height="18" VerticalAlignment="Center"
                           Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="RTSP Camera Viewer" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="CameraCountText" Grid.Column="1" Text="0 cameras"
                           Foreground="{StaticResource TextSecondary}" FontSize="12"
                           VerticalAlignment="Center" Margin="14,0,12,0" TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Height="32" Padding="12,0" Click="AddCamera_Click" Style="{StaticResource AccentButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Add Camera" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsButton" Content="&#xE713;" FontFamily="Segoe MDL2 Assets"
                            Width="36" Height="32" Margin="6,0,0,0" FontSize="14"
                            Click="Settings_Click" ToolTip="Settings — stream quality and camera classes"
                            Style="{StaticResource IconButton}"/>
                    <Button x:Name="AppFullscreenButton" Content="&#xE740;" FontFamily="Segoe MDL2 Assets"
                            Width="36" Height="32" Margin="2,0,0,0" FontSize="14"
                            Click="AppFullscreen_Click" ToolTip="Full screen (F11)" Style="{StaticResource IconButton}"/>
                </StackPanel>

                <!-- Room for the system caption buttons (3 x 46px), which DWM draws here. -->
                <Border Grid.Column="3" Width="142"/>
            </Grid>

            <!-- View bar: which class is on screen (left), how it is shown (right). -->
            <Border x:Name="StoreBar" DockPanel.Dock="Top" Background="Transparent" Padding="16,0,16,10">
                <Grid>
                    <StackPanel x:Name="ClassPickerPanel" Orientation="Horizontal" HorizontalAlignment="Left"
                                Visibility="Collapsed">
                        <TextBlock Text="Camera class" Foreground="{StaticResource TextSecondary}" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox x:Name="StoreSelector" Width="240" SelectionChanged="StoreSelector_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Window count. The cap is a hardware limit, not a preference — see
                             ViewLayout.MaxWindows — so the + button simply stops at it. -->
                        <TextBlock Text="Windows" Foreground="{StaticResource TextSecondary}" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <RepeatButton x:Name="FewerWindowsButton" Content="&#xE738;" Click="FewerWindows_Click"
                                      Style="{StaticResource StepperButton}" ToolTip="Show fewer windows (Ctrl+−)"/>
                        <Border Background="{StaticResource ControlFill}" BorderBrush="{StaticResource ControlStroke}"
                                BorderThickness="0,1,0,1" Height="28" MinWidth="40">
                            <TextBlock x:Name="WindowCountText" Text="12" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <RepeatButton x:Name="MoreWindowsButton" Content="&#xE710;" Click="MoreWindows_Click"
                                      Style="{StaticResource StepperButton}" ToolTip="Show more windows (Ctrl++)"/>

                        <Border Width="1" Height="20" Background="{StaticResource ControlStroke}" Margin="12,0"/>

                        <!-- Picture adjustments for the live feed. Deliberately unavailable in
                             All Classes: there it would mean "apply to everything at once",
                             which is a destructive-feeling edit across cameras the user cannot
                             all see. Pick a class (or expand one camera) and it turns on. -->
                        <Button x:Name="FilterButton" Height="28" Padding="10,0" Click="Filter_Click"
                                Style="{StaticResource ToolButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE793;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Filter" FontSize="12" VerticalAlignment="Center"/>
                                <Ellipse x:Name="FilterActiveDot" Width="6" Height="6" Margin="8,0,0,0"
                                         Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                         Visibility="Collapsed"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Expanded-view bar. The collapse control lives here rather than over the video,
                 because a native video surface paints over anything WPF draws on top of it. -->
            <Border x:Name="ExpandBar" DockPanel.Dock="Top" Background="Transparent" Padding="16,0,16,8" Visibility="Collapsed">
                <Grid>
                    <TextBlock x:Name="ExpandNameText" Text="Expanded" Foreground="{StaticResource TextSecondary}"
                               FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Expanded view is where picture adjustment belongs most: one camera,
                             filling the window, so the effect of a slider is actually visible. -->
                        <Button x:Name="ExpandAdjustButton" Height="30" Padding="10,0" Click="Filter_Click"
                                ToolTip="Adjust this camera's picture" Style="{StaticResource ToolButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE793;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Adjust picture" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Height="30" Padding="10,0" Margin="6,0,0,0" Click="ExitFullscreen_Click"
                                ToolTip="Back to the grid (Esc)" Style="{StaticResource ToolButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73F;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Back to grid" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content layer: the grid sits on a raised, rounded surface over the Mica window,
                 like the content pane in Windows Settings. -->
            <Border Background="{StaticResource LayerBackground}" BorderBrush="{StaticResource CardStroke}"
                    BorderThickness="1,1,1,0" CornerRadius="8,8,0,0" Padding="4">
                <Grid>
                    <TextBlock x:Name="EmptyStateText" Text="No cameras yet. Click &quot;Add Camera&quot; to add your first RTSP stream."
                               Foreground="{StaticResource TextSecondary}" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

                    <UniformGrid x:Name="GridHost" SizeChanged="GridHost_SizeChanged"/>

                    <!--
                        Picture adjustment flyout, shared by the grid's Filter button and the
                        expanded view's Adjust button. One panel rather than two: the controls
                        are identical and only the SCOPE differs, which the header states
                        outright instead of leaving the user to infer it from which button they
                        pressed.

                        A Popup because it opens over the native video surface, which paints over
                        anything WPF draws in its rectangle. The sliders themselves are built in
                        code (BuildAdjustPanel) from VideoAdjustments.AllKnobs, so the ranges
                        shown are LibVLC's own and a knob cannot drift out of sync with the
                        filter behind it.
                    -->
                    <Popup x:Name="AdjustPopup" Placement="Bottom" AllowsTransparency="True"
                           StaysOpen="False" Focusable="True" HorizontalOffset="-260" VerticalOffset="6"
                           Closed="AdjustPopup_Closed">
                        <Border Background="{StaticResource FlyoutBackground}" BorderBrush="{StaticResource ControlStroke}"
                                BorderThickness="1" CornerRadius="8" Padding="16,14" Width="340" Margin="10"
                                Effect="{StaticResource FlyoutShadow}">
                            <StackPanel>
                                <TextBlock x:Name="AdjustScopeText" Text="Picture" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock x:Name="AdjustScopeHint" Text="" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondary}" Margin="0,3,0,10"/>

                                <!-- Preset looks, two to a row like a filter tray. Each square is
                                     generated from the preset's own maths (PresetThumbnail), so
                                     the swatch is the effect rather than a picture of it. -->
                                <TextBlock Text="PRESETS" Foreground="{StaticResource TextSecondary}"
                                           FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ScrollViewer MaxHeight="186" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="PresetPanel" Margin="0,0,6,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Border Height="1" Background="{StaticResource ControlStroke}" Margin="0,12,0,4"/>

                                <TextBlock Text="FINE TUNE" Foreground="{StaticResource TextSecondary}"
                                           FontSize="10.5" FontWeight="SemiBold" Margin="0,4,0,0"/>

                                <StackPanel x:Name="AdjustKnobPanel"/>

                                <Grid Margin="0,12,0,0">
                                    <Button x:Name="AdjustResetButton" HorizontalAlignment="Left" Height="30"
                                            Padding="10,0" Click="AdjustReset_Click" Style="{StaticResource ToolButton}"
                                            ToolTip="Put every slider back to neutral">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Reset" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button HorizontalAlignment="Right" Height="30" Padding="14,0"
                                            Click="AdjustDone_Click" Style="{StaticResource AccentButton}"
                                            Content="Done"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
        </DockPanel>
    </Border>
</Window>
