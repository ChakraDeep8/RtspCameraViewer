<UserControl x:Class="RtspCameraViewer.Controls.CameraTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             MinWidth="160" MinHeight="120">
    <Border Background="{StaticResource TileBackground}" CornerRadius="8" ClipToBounds="True"
            BorderBrush="#3A3A44" BorderThickness="1" Margin="4">
        <Grid>
            <vlc:VideoView x:Name="Video" Background="Black"/>

            <!-- Placeholder shown while connecting / on error. Covers the whole tile (not just the
                 text) — the video surface beneath renders white until its first real frame
                 arrives, so a center-only placeholder let that white show through everywhere
                 else in the tile. -->
            <Border x:Name="PlaceholderPanel" Background="{StaticResource TileBackground}" Visibility="Visible">
                <TextBlock x:Name="PlaceholderText" Text="Connecting…" Foreground="{StaticResource TextSecondary}"
                           FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Top overlay: name + status -->
            <Border VerticalAlignment="Top" Background="#B0000000" Padding="8,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource WarnBrush}"
                             VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock x:Name="NameText" Grid.Column="1" Text="Camera" Foreground="White"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="StatusText" Grid.Column="2" Text="" Foreground="{StaticResource TextSecondary}"
                               FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
            </Border>

            <!-- Hover toolbar -->
            <StackPanel x:Name="HoverToolbar" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Bottom" Margin="0,0,6,6" Opacity="0" Panel.ZIndex="5">
                <Button x:Name="FullscreenButton" Content="⛶" Width="30" Height="26" Margin="3,0,0,0"
                        Click="FullscreenButton_Click" ToolTip="Full screen" Style="{StaticResource ToolButton}"/>
                <Button x:Name="ReconnectButton" Content="⟳" Width="30" Height="26" Margin="3,0,0,0"
                        Click="ReconnectButton_Click" ToolTip="Reconnect" Style="{StaticResource ToolButton}"/>
                <Button x:Name="RemoveButton" Content="✕" Width="30" Height="26" Margin="3,0,0,0"
                        Click="RemoveButton_Click" ToolTip="Remove camera" Style="{StaticResource ToolButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
