<UserControl x:Class="RtspCameraViewer.Controls.CameraTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <!-- No MinWidth/MinHeight: the grid sizes the cells. A minimum larger than the cell made
         every tile overhang its neighbour whenever many cameras shared the grid, and because
         the video is a native window, the overhang painted over the next tile's name bar. -->
    <UserControl.Resources>
        <!-- Round, translucent move arrow. Solid enough to read over any video, and it takes the
             accent colour on hover like other Windows 11 flyout buttons. -->
        <Style x:Key="MoveArrowButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="17" Background="#D9202020" BorderBrush="#40FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFill}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentForeground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource TileBackground}" CornerRadius="8" ClipToBounds="True"
            BorderBrush="{StaticResource CardStroke}" BorderThickness="1" Margin="4">
        <!--
            Moving a tile: a thin strip on each edge detects the hover, and the arrow for that
            edge fades in over the video. The strips never change size, so the video is never
            pushed or resized.

            The arrows are Popups, not ordinary children, because the video is a native window
            that paints over anything WPF draws in its rectangle - an arrow placed there directly
            would be invisible. A Popup is its own window, so it can sit on top of the feed, the
            same way the class dropdown opens over it.
        -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="EdgeUp" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Height="6" Tag="Up"
                    Background="{StaticResource TileBackground}" MouseEnter="Edge_MouseEnter" MouseLeave="Edge_MouseLeave"/>
            <Border x:Name="EdgeDown" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Height="6" Tag="Down"
                    Background="{StaticResource TileBackground}" MouseEnter="Edge_MouseEnter" MouseLeave="Edge_MouseLeave"/>
            <Border x:Name="EdgeLeft" Grid.Row="1" Grid.Column="0" Width="6" Tag="Left"
                    Background="{StaticResource TileBackground}" MouseEnter="Edge_MouseEnter" MouseLeave="Edge_MouseLeave"/>
            <Border x:Name="EdgeRight" Grid.Row="1" Grid.Column="2" Width="6" Tag="Right"
                    Background="{StaticResource TileBackground}" MouseEnter="Edge_MouseEnter" MouseLeave="Edge_MouseLeave"/>

            <Popup x:Name="UpArrowPopup" PlacementTarget="{Binding ElementName=ContentGrid}" Placement="Relative"
                   AllowsTransparency="True" StaysOpen="True" Focusable="False">
                <Button x:Name="MoveUpButton" Tag="Up" Content="&#xE70E;" Opacity="0" ToolTip="Move up"
                        Click="Move_Click" MouseLeave="Arrow_MouseLeave" Style="{StaticResource MoveArrowButton}"/>
            </Popup>
            <Popup x:Name="DownArrowPopup" PlacementTarget="{Binding ElementName=ContentGrid}" Placement="Relative"
                   AllowsTransparency="True" StaysOpen="True" Focusable="False">
                <Button x:Name="MoveDownButton" Tag="Down" Content="&#xE70D;" Opacity="0" ToolTip="Move down"
                        Click="Move_Click" MouseLeave="Arrow_MouseLeave" Style="{StaticResource MoveArrowButton}"/>
            </Popup>
            <Popup x:Name="LeftArrowPopup" PlacementTarget="{Binding ElementName=ContentGrid}" Placement="Relative"
                   AllowsTransparency="True" StaysOpen="True" Focusable="False">
                <Button x:Name="MoveLeftButton" Tag="Left" Content="&#xE76B;" Opacity="0" ToolTip="Move left"
                        Click="Move_Click" MouseLeave="Arrow_MouseLeave" Style="{StaticResource MoveArrowButton}"/>
            </Popup>
            <Popup x:Name="RightArrowPopup" PlacementTarget="{Binding ElementName=ContentGrid}" Placement="Relative"
                   AllowsTransparency="True" StaysOpen="True" Focusable="False">
                <Button x:Name="MoveRightButton" Tag="Right" Content="&#xE76C;" Opacity="0" ToolTip="Move right"
                        Click="Move_Click" MouseLeave="Arrow_MouseLeave" Style="{StaticResource MoveArrowButton}"/>
            </Popup>

            <!-- Tile content: header row above the video (see note on the edge strips). -->
            <Grid x:Name="ContentGrid" Grid.Row="1" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border x:Name="HeaderBar" Grid.Row="0" Background="{StaticResource TileHeaderBackground}" Padding="8,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource WarnBrush}"
                                 VerticalAlignment="Center" Margin="0,0,7,0"/>

                        <!-- The name stays a plain label: double-clicking the header is what
                             expands a tile, and wrapping the name in a button swallowed that. The
                             chevron beside it is the source picker — its own small target, next
                             to the name because that is where "what am I watching?" is answered. -->
                        <TextBlock x:Name="NameText" Grid.Column="1" Text="Camera" Foreground="{StaticResource TextPrimary}"
                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

                        <Button x:Name="SourceButton" Grid.Column="2" Click="SourceButton_Click"
                                Style="{StaticResource SourcePickerButton}" Padding="5,3" Margin="4,0,0,0"
                                ToolTip="Choose which camera this window shows">
                            <TextBlock x:Name="SourceChevron" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="8" Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"/>
                        </Button>

                        <!-- Its own window, so it can open over the native video surface. -->
                        <Popup x:Name="SourcePopup" PlacementTarget="{Binding ElementName=HeaderBar}" Placement="Bottom"
                               AllowsTransparency="True" StaysOpen="False" Focusable="True"
                               Opened="SourcePopup_Opened" HorizontalOffset="0">
                            <Border Background="{StaticResource FlyoutBackground}" BorderBrush="{StaticResource ControlStroke}"
                                    BorderThickness="1" CornerRadius="8" Padding="8" MinWidth="240" MaxWidth="340"
                                    Margin="6" Effect="{StaticResource FlyoutShadow}">
                                <StackPanel>
                                    <Grid>
                                        <TextBox x:Name="SourceSearch" Style="{StaticResource InputBox}" Height="30"
                                                 TextChanged="SourceSearch_TextChanged"/>
                                        <TextBlock x:Name="SourceSearchHint" Text="Search cameras…" IsHitTestVisible="False"
                                                   Foreground="{StaticResource TextSecondary}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="11,0,0,0"/>
                                    </Grid>
                                    <ListBox x:Name="SourceList" MaxHeight="280" Margin="0,8,0,0"
                                             Background="Transparent" BorderThickness="0"
                                             SelectionChanged="SourceList_SelectionChanged"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                    <TextBlock x:Name="SourceEmptyText" Text="No other cameras in this view."
                                               Foreground="{StaticResource TextSecondary}" FontSize="12"
                                               Margin="4,8,4,4" Visibility="Collapsed" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <TextBlock x:Name="StatusText" Grid.Column="3" Text="" Foreground="{StaticResource TextSecondary}"
                                   FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>

                        <!-- Segoe MDL2 Assets, not literal symbols: the obvious characters are absent
                             from Segoe UI and rendered blank. Collapsed rather than transparent, so
                             it does not reserve width and squeeze the name when hidden. -->
                        <StackPanel x:Name="HoverToolbar" Grid.Column="4" Orientation="Horizontal"
                                    VerticalAlignment="Center" Visibility="Collapsed" Margin="8,0,0,0">
                            <Button x:Name="FullscreenButton" Content="&#xE740;" FontFamily="Segoe MDL2 Assets" Width="26" Height="24" Margin="2,0,0,0" FontSize="10"
                                    Click="FullscreenButton_Click" ToolTip="Expand (or double-click the tile)" Style="{StaticResource IconButton}"/>
                            <Button x:Name="ReconnectButton" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Width="26" Height="24" Margin="2,0,0,0" FontSize="10"
                                    Click="ReconnectButton_Click" ToolTip="Reconnect" Style="{StaticResource IconButton}"/>
                            <Button x:Name="RemoveButton" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Width="26" Height="24" Margin="2,0,0,0" FontSize="10"
                                    Click="RemoveButton_Click" ToolTip="Remove camera" Style="{StaticResource IconButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- The placeholder is the VideoView's CONTENT, not a sibling: VideoView renders its
                     content in an overlay window above the video surface, the one sanctioned way to
                     draw over it. -->
                <vlc:VideoView x:Name="Video" Grid.Row="1" Background="Black">
                    <Border x:Name="PlaceholderPanel" Background="{StaticResource TileBackground}" Visibility="Visible">
                        <TextBlock x:Name="PlaceholderText" Text="Connecting…" Foreground="{StaticResource TextSecondary}"
                                   FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </vlc:VideoView>
            </Grid>
        </Grid>
    </Border>
</UserControl>
